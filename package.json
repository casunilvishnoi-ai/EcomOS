    "db:postgres-schema": "sh scripts/postgres-schema.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@prisma/client": "^6.19.3",
    "exceljs": "^4.4.0",
    "next": "16.4.4",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
